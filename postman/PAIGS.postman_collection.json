    {
      "name": "End-to-end (Orchestration)",
      "item": [
        {
          "name": "Create run - single file, before any reference DB published",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/runs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "runs"
              ]
            },
            "description": "First half of exercising 'stops at blast when no reference database is published' -- created before the publish request below runs, so no reference database is active yet.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "forward_read",
                  "type": "file",
                  "src": "/Users/mac/projects/paigs-wildid/postman/test-data/3100.ab1"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('run_id_no_ref', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Execute run - stops at blast when no reference database is published",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/runs/{{run_id_no_ref}}/execute",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "runs",
                "{{run_id_no_ref}}",
                "execute"
              ]
            },
            "description": "Stages 1-8 (format_check through fasta) all succeed on a real single AB1 read; Stage 9 (blast) has nothing to search against yet, so the run stops there with status=failed rather than throwing -- an operational stop, not a biological one."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('run status is failed', () => pm.expect(body.status).to.eql('failed'));",
                  "pm.test('stopped at blast', () => pm.expect(body.current_stage).to.eql('blast'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Publish reference database (matches 3100.ab1)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/reference-database/publish",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "reference-database",
                "publish"
              ]
            },
            "description": "Publishes a one-entry reference database whose sequence is 3100.ab1's own real trimmed output (see postman/test-data/reference.fasta) -- guarantees a clean, unambiguous 100%-identity/coverage BLAST hit for the requests below, so this exercises Stage 9-11 against a real match rather than a fabricated one.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "fasta",
                  "type": "file",
                  "src": "/Users/mac/projects/paigs-wildid/postman/test-data/reference.fasta"
                },
                {
                  "key": "version",
                  "type": "text",
                  "value": "v1-e2e"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('version matches', () => pm.expect(pm.response.json().version).to.eql('v1-e2e'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create run - single file, for full completion",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/runs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "runs"
              ]
            },
            "description": "A fresh run (a run can only be executed once -- see 'already executed' below), created now that a matching reference database is active.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "forward_read",
                  "type": "file",
                  "src": "/Users/mac/projects/paigs-wildid/postman/test-data/3100.ab1"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('run_id_complete', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Execute run - completes the full pipeline (Stage 1 through Stage 11)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/runs/{{run_id_complete}}/execute",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "runs",
                "{{run_id_complete}}",
                "execute"
              ]
            },
            "description": "Runs every stage end to end: format_check, ab1_extraction, sanity_check, trim, orientation (skipped -- single-read path), consensus (skipped), usability_check, fasta, blast, identification, report. Always 200 -- the biological/QC outcome is data on the Run/Stage response, not an HTTP error."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
