            "description": "Run summary + every stage's status. Only 'import' should be completed at this point (format_check, ab1_extraction, ... are not built yet)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('import stage completed', () => {",
                  "  const importStage = body.stages.find(s => s.stage_type === 'import');",
                  "  pm.expect(importStage.status).to.eql('completed');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get import stage output",
          "request": {
