              "raw": "{{base_url}}/runs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "runs"
              ]
            },
            "description": "Stage 0 (Import), two-read path. Uploads into the forward_read and reverse_read slots. Both single- and two-file are first-class per the current CLAUDE.md -- this is the two-file case. Saves run_id into the environment for the requests below.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "forward_read",
                  "type": "file",
                  "src": "/Users/mac/projects/paigs-wildid/postman/test-data/3100.ab1"
                },
                {
                  "key": "reverse_read",
                  "type": "file",
                  "src": "/Users/mac/projects/paigs-wildid/postman/test-data/3730.ab1"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('has id', () => pm.expect(body.id).to.be.a('string'));",
                  "pm.test('current_stage is import', () => pm.expect(body.current_stage).to.eql('import'));",
                  "pm.test('status is in_progress', () => pm.expect(body.status).to.eql('in_progress'));",
                  "pm.test('both filenames present, in slot order', () => {",
                  "  pm.expect(body.original_filenames).to.eql(['3100.ab1', '3730.ab1']);",
                  "});",
                  "pm.environment.set('run_id', body.id);",
                  "pm.environment.set('run_sample_id', body.sample_id);"
                ]
              }
            }
          ]
        },
